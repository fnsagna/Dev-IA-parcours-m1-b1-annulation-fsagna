# Identifiants de la base PostgreSQL LOCALE (développement uniquement).
# Copier ce fichier en .env :  cp .env.example .env
POSTGRES_USER=escale
POSTGRES_PASSWORD=escale_dev
POSTGRES_DB=reservations
# Port exposé sur la machine hôte (5432 par défaut ; mettre 5433 si un PostgreSQL local occupe déjà 5432)
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://escale:escale_dev@localhost:5432/reservations
